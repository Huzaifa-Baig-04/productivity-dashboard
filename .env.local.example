# Firebase Configuration for Development
# Copy these values from Firebase Console: https://console.firebase.google.com
# Project Settings → Service Accounts

# Get these from your Firebase Web App configuration
VITE_FIREBASE_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcd1234ef5678gh

# For Android app, use the same Firebase project
# Android will use google-services.json with same credentials
